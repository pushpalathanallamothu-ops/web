
<!DOCTYPE html>
<html>
<head>
    <title>My E-Commerce Store</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f4;
        }

        /* Navigation */
        nav {
            background: #172554;
            color: white;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        nav h2 {
            margin: 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
        }

        nav a:hover {
            color: yellow;
        }

        /* Banner */
        .banner {
            background: #2563eb;
            color: white;
            text-align: center;
            padding: 40px;
        }

        .banner h1 {
            font-size: 35px;
        }

        /* Categories */
        .categories {
            text-align: center;
            padding: 20px;
        }

        .categories button {
            padding: 10px 20px;
            margin: 5px;
            background: #172554;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .categories button:hover {
            background: #2563eb;
        }

        /* Products */
        .products {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .product {
            background: white;
            padding: 15px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
            transition: 0.3s;
        }

        .product:hover {
            transform: translateY(-8px);
        }

        .product img {
            width: 100%;
            height: 180px;
            object-fit: contain;
        }

        .price {
            color: green;
            font-size: 20px;
            font-weight: bold;
        }

        .old-price {
            color: gray;
            text-decoration: line-through;
        }

        .discount {
            color: red;
            font-weight: bold;
        }

        .rating {
            color: orange;
        }

        .product button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        .product button:hover {
            background: #172554;
        }

        /* Footer */
        footer {
            background: #172554;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 20px;
        }

        @media(max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 10px;
            }

            .banner h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

<!-- Navigation Bar -->
<nav>
    <h2>MyShop</h2>
    <div>
        <a href="#">Home</a>
        <a href="#categories">Categories</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
        <a href="#products">🛒 Cart</a>
    </div>
</nav>

<!-- Promotional Banner -->
<div class="banner">
    <h1>Big Shopping Sale!</h1>
    <p>Get Up To 50% OFF on Selected Products</p>
    <button onclick="location.href='#products'">
        Shop Now
    </button>
</div>

<!-- Categories -->
<div class="categories" id="categories">
    <h2>Product Categories</h2>
    <button>All</button>
    <button>Electronics</button>
    <button>Fashion</button>
    <button>Accessories</button>
</div>

<!-- Product Section -->
<h2 style="text-align:center;">Our Products</h2>

<div class="products" id="products">

    <div class="product">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30f?w=400" alt="Headphones">
        <h3>Headphones</h3>
        <p>High quality wireless headphones.</p>
        <p class="rating">★★★★★ (4.5)</p>
        <p class="price">₹1,499</p>
        <p class="old-price">₹2,999</p>
        <p class="discount">50% OFF</p>
        <button onclick="alert('Headphones added to cart!')">
            Add to Cart
        </button>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400" alt="Watch">
        <h3>Smart Watch</h3>
        <p>Stylish watch with smart features.</p>
        <p class="rating">★★★★★ (4.3)</p>
        <p class="price">₹2,499</p>
        <p class="old-price">₹3,999</p>
        <p class="discount">35% OFF</p>
        <button onclick="alert('Watch added to cart!')">
            Add to Cart
        </button>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400" alt="Shoes">
        <h3>Sports Shoes</h3>
        <p>Comfortable shoes for daily use.</p>
        <p class="rating">★★★★☆ (4.2)</p>
        <p class="price">₹1,999</p>
        <p class="old-price">₹2,999</p>
        <p class="discount">30% OFF</p>
        <button onclick="alert('Shoes added to cart!')">
            Add to Cart
        </button>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=400" alt="Camera">
        <h3>Digital Camera</h3>
        <p>Capture beautiful moments.</p>
        <p class="rating">★★★★★ (4.8)</p>
        <p class="price">₹8,999</p>
        <p class="old-price">₹11,999</p>
        <p class="discount">25% OFF</p>
        <button onclick="alert('Camera added to cart!')">
            Add to Cart
        </button>
    </div>

</div>

<!-- Footer -->
<footer id="contact">
    <h3>MyShop</h3>
    <p>Email: myshop@gmail.com</p>
    <p>Contact: 9876543210</p>
    <p>© 2026 MyShop. All Rights Reserved.</p>
</footer>

</body>
</html>
