
<!DOCTYPE html>
<html>
<head>
    <title>My Personal Website</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f2f5fa;
            scroll-behavior: smooth;
        }

        header {
            background: #172554;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #2563eb;
            padding: 15px;
            text-align: center;
            position: sticky;
            top: 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
            font-weight: bold;
        }

        nav a:hover {
            color: yellow;
        }

        section {
            background: white;
            margin: 20px;
            padding: 25px;
            border-radius: 10px;
            animation: fade 1s;
        }

        h2 {
            color: #2563eb;
        }

        button {
            background: #2563eb;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #172554;
        }

        footer {
            background: #172554;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @keyframes fade {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            nav a {
                display: inline-block;
                margin: 8px;
            }

            section {
                margin: 10px;
            }
        }
    </style>
</head>

